# Copy this file to `.env` (which git ignores) and fill in your own values.
# Never commit a real `.env`.

PORT=3001

# Auth0: the tenant and the API identifier the front end requests tokens for.
# These must come from the SAME tenant as the front end's VITE_AUTH0_* settings.
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://your-api-identifier

# Local MySQL (see docs/local-dev-schema.sql)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=reusefull
DB_USER=root
DB_PASSWORD=root

# Optional: shared secret for POST /users when called from an Auth0 Action
ACTION_SHARED_SECRET=change_me

# The front end's address (CORS)
CORS_ORIGIN=http://localhost:5173

# AWS (only needed to test logo uploads against the real bucket)
AWS_REGION=us-east-2
S3_BUCKET=reusefullimages

# Optional: where new-signup notification emails go. Point at a dummy address
# for local testing so a real inbox is never emailed.
# ADMIN_NOTIFICATION_EMAIL=local-test@example.invalid
